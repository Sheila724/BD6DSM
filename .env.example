# =====================================================
# Banco PRIMARIO (escrita)
# =====================================================
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=3306
DB_PRIMARY_DATABASE=aula-db
DB_PRIMARY_USERNAME=root
DB_PRIMARY_PASSWORD=teste

# =====================================================
# Replicas (leitura) - separadas por virgula: host:porta
# Localmente: aponta para o mesmo banco do primario.
# Na apresentacao: substituir pelo IP/porta fornecido pelo professor.
# Para N replicas: DB_REPLICAS=host1:3306,host2:3306,host3:3306
# =====================================================
DB_REPLICAS=localhost:3306
DB_REPLICA_DATABASE=aula-db
DB_REPLICA_USERNAME=root
DB_REPLICA_PASSWORD=teste

# =====================================================
# Servidor (opcional, padrao 8080)
# =====================================================
PORT=8080
